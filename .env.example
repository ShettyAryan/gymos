# GymOS mobile app configuration. Copy to `.env` (git-ignored) and fill in.
# Leave both blank to run in local-only mode (no account, no cloud, AI via Mock AI only).
#
# These two values are PUBLIC by design (embedded in the app bundle) and are protected by
# Row Level Security. NEVER put a service-role key, a Groq key or any other secret in an
# EXPO_PUBLIC_* variable.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Edge Function secrets (GROQ_API_KEY, model chain, AI limits) do NOT go here.
# See supabase/functions/.env.example and README → "Groq setup".
