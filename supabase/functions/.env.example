# Supabase Edge Function secrets — placeholders only.
# Copy to supabase/functions/.env (git-ignored) and run:
#   supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase; never set
# them in the mobile app.

# Groq API key from https://console.groq.com/keys (Free plan; no payment method needed).
GROQ_API_KEY=your-groq-api-key

# Free-tier model chain (verify on console.groq.com/docs/rate-limits and /deprecations before release).
GROQ_MODEL_PRIMARY=openai/gpt-oss-120b
GROQ_MODEL_LIGHT=openai/gpt-oss-20b
GROQ_MODEL_BACKUP=qwen/qwen3.8-27b

# Quota protection (the Groq free quota is shared by all users of this project).
AI_USER_DAILY_LIMIT=20
AI_MODEL_MIN_REMAINING_REQUESTS=25
AI_MODEL_MIN_REMAINING_TOKENS=2500
AI_TIMEOUT_MS=25000
AI_MAX_INPUT_CHARS=12000
